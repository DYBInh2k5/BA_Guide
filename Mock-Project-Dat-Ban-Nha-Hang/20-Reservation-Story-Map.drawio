<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-11-20T10:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="story-map" name="Story Map"><mxGraphModel dx="1900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value="1. Khám phá" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="4" value="2. Tìm slot" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="5" value="3. Gửi yêu cầu" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="6" value="4. Xử lý" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="7" value="5. Nhận kết quả" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="8" value="6. Đến nhà hàng" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1F4E78;align=center;verticalAlign=middle;fontStyle=1; fillColor=#1F4E78;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1540" y="40" width="270" height="70" as="geometry"/></mxCell><mxCell id="9" value="MVP — lát cắt end-to-end" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#B4C7E7;align=left;verticalAlign=middle;fontStyle=1; fillColor=#D9EAF7;fontColor=#17365D;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1860" height="45" as="geometry"/></mxCell><mxCell id="10" value="Xác minh quy tắc giờ mở, capacity, ai quyết định. Ghi evidence / open questions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="11" value="Khách chọn ngày, giờ, số khách; hiển thị slot còn nhận theo rule đã duyệt." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="12" value="Nhập thông tin hợp lệ → tạo mã duy nhất + trạng thái PENDING. Không báo đã xác nhận." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="13" value="Lễ tân xem queue; xác nhận / từ chối; ghi actor, thời điểm, lý do." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="14" value="Gửi email kết quả. Lỗi gửi được ghi nhận; quyết định booking vẫn giữ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="15" value="Check-in / show-up chỉ khi có quy trình và dữ liệu đáng tin; đo baseline trước khi đặt target." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#E2F0D9;fontColor=#263238;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1540" y="190" width="270" height="155" as="geometry"/></mxCell><mxCell id="16" value="Sau MVP — chỉ làm khi có bằng chứng, policy và owner" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#FFD966;align=left;verticalAlign=middle;fontStyle=1; fillColor=#FFF2CC;fontColor=#7F6000;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1860" height="45" as="geometry"/></mxCell><mxCell id="17" value="Nghiên cứu theo dõi funnel và phỏng vấn khách; không suy ra nhu cầu tính năng từ giả định." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="18" value="Waitlist hoặc lịch nhiều ca nếu có nhu cầu và rule vận hành rõ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="19" value="Sửa/hủy tự phục vụ sau khi chốt chính sách, xác thực và thời hạn." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="20" value="Quản lý ca / escalation nâng cao khi volume hoặc dữ liệu chứng minh cần." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="21" value="SMS sau khi xác nhận consent, privacy, chi phí, provider, retry, vận hành." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="22" value="Báo cáo phân đoạn theo ngày/kênh nếu data quality và quyền sử dụng cho phép." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FFF8E1;fontColor=#5B4A00;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1540" y="440" width="270" height="130" as="geometry"/></mxCell><mxCell id="23" value="Câu hỏi cần trả lời trước khi cam kết" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#F4B183;align=left;verticalAlign=middle;fontStyle=1; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1860" height="45" as="geometry"/></mxCell><mxCell id="24" value="Ai là stakeholder xác nhận problem và baseline?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="270" height="100" as="geometry"/></mxCell><mxCell id="25" value="Capacity tính theo ghế, bàn hay slot? Xử lý hai request đồng thời thế nào?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="660" width="270" height="100" as="geometry"/></mxCell><mxCell id="26" value="Retry/timeout có tạo booking trùng không? Cần idempotency?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="660" width="270" height="100" as="geometry"/></mxCell><mxCell id="27" value="Ai có quyền quyết định? Khi nào cần quản lý duyệt?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="660" width="270" height="100" as="geometry"/></mxCell><mxCell id="28" value="Email lỗi: retry, cảnh báo, fallback và owner nào?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="660" width="270" height="100" as="geometry"/></mxCell><mxCell id="29" value="Định nghĩa booking due, attended, no-show; nguồn timestamp chuẩn?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#667085; fillColor=#FCE4D6;fontColor=#843C0C;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1540" y="660" width="270" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
