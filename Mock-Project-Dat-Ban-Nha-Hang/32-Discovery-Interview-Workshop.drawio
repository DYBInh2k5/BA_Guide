<mxfile host="app.diagrams.net" modified="2026-11-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="discovery-workshop" name="Discovery interview workshop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="DISCOVERY — ĐẶT BÀN NHÀ HÀNG (CASE STUDY GIẢ LẬP)&#xa;Mục tiêu: hiểu vấn đề, kiểm chứng nguồn, chưa chọn giải pháp" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1450" height="70" as="geometry"/></mxCell>
        <mxCell id="guide" value="CÁCH DÙNG&#xa;1. Ghi một ý mỗi thẻ. 2. Gắn nguồn/ngày. 3. Tách lời kể, bằng chứng, giả định và quyết định. 4. Chỉ chuyển sang requirement khi need đã được xác nhận." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=14;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1450" height="85" as="geometry"/></mxCell>
        <mxCell id="c1" value="1 · VẤN ĐỀ &amp; TÁC ĐỘNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#6C8EBF;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="c1a" value="Trigger / bối cảnh&#xa;Ai gặp vấn đề? Khi nào?&#xa;&#xa;Ví dụ gần nhất&#xa;Kể từng bước, không suy đoán nguyên nhân&#xa;&#xa;Tác động&#xa;Khách / nhân viên / vận hành / doanh thu?&#xa;Outcome nào đã xác minh?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="c1b" value="Câu hỏi ưu tiên&#xa;• Lần gần nhất xảy ra khi nào?&#xa;• Ai nhận yêu cầu và làm gì tiếp?&#xa;• Khách/nhân viên bị ảnh hưởng ra sao?&#xa;• Có ngoại lệ hay workaround nào?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="525" width="300" height="185" as="geometry"/></mxCell>
        <mxCell id="c2" value="2 · LỜI KỂ &amp; EVIDENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="235" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="c2a" value="Claim / lời kể&#xa;Ai nói? Ngày nào?&#xa;Câu chữ nguyên ý là gì?&#xa;&#xa;Nguồn kiểm tra&#xa;Tin nhắn / sổ / log / quan sát / phỏng vấn khác&#xa;&#xa;Evidence metadata&#xa;Khoảng thời gian, định nghĩa, mẫu, hạn chế, quyền truy cập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="430" y="295" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="c2b" value="Không ghi dữ liệu cá nhân thật lên board học tập.&#xa;&#xa;Phân biệt:&#xa;• stakeholder kể ≠ đã kiểm chứng&#xa;• ước lượng ≠ baseline&#xa;• tương quan ≠ nguyên nhân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#82B366;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="430" y="525" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c3" value="3 · ASSUMPTION &amp; OPEN QUESTIONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="780" y="235" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="c3a" value="Assumption cần kiểm tra&#xa;A-01: __________&#xa;A-02: __________&#xa;&#xa;Open question&#xa;OQ-01 · Nội dung / owner / hạn&#xa;OQ-02 · Nội dung / owner / hạn&#xa;&#xa;Decision cần người có thẩm quyền chốt&#xa;D-01: __________" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="800" y="295" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="c3b" value="Giải pháp được gợi ý&#xa;“Làm app đặt bàn”&#xa;&#xa;Trạng thái: solution hypothesis&#xa;Chưa coi là requirement/decision&#xa;&#xa;Phương án khác cần xem xét sau khi hiểu need" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="800" y="525" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="c4" value="4 · HÀNH ĐỘNG &amp; ĐẦU RA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1150" y="235" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="c4a" value="Action log&#xa;• Việc cần làm&#xa;• Owner&#xa;• Due date&#xa;• Evidence/deliverable&#xa;&#xa;Tóm tắt để stakeholder xác nhận&#xa;“Em hiểu rằng… Điều chưa rõ là… Bước tiếp theo…”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="295" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="c4b" value="Sau discovery mới chuyển thành&#xa;Problem → Need → Requirement → AC → UAT → Evidence&#xa;&#xa;Gate: source, owner, status và open question có thể truy vết." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="525" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="footer" value="Bản thực hành cá nhân · Nội dung và stakeholder đều giả lập · Không dùng để tuyên bố đã nghiên cứu khách hàng thật" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1450" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
