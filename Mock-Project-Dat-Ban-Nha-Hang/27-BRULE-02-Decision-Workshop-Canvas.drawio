<mxfile host="app.diagrams.net" modified="2026-11-26T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="brule-02-workshop-canvas" name="BRULE-02 Decision Workshop Canvas">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BRULE-02 | DECISION WORKSHOP CANVAS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1460" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Case study giả lập · chưa có quyết định được duyệt · dùng bản sao để ghi kết quả workshop" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="50" y="75" width="1460" height="34" as="geometry"/></mxCell>
        <mxCell id="purpose" value="Mục tiêu: làm rõ PENDING có giữ capacity không, căn cứ nào cần có, ai có quyền quyết định và artifact nào bị ảnh hưởng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4676B8;fontSize=16;fontColor=#172B4D;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="1460" height="58" as="geometry"/></mxCell>
        <mxCell id="evidence-card" value="&lt;b&gt;1. EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reported trong role-play: quản lý nhớ hai nhóm cùng tới lúc 19:30 và cả hai nói đã đặt.&lt;br&gt;&lt;br&gt;Trạng thái: chưa đối chiếu hồ sơ; không kết luận nguyên nhân.&lt;br&gt;&lt;br&gt;Ghi tại workshop:&lt;br&gt;• Source / thời điểm / phạm vi:&lt;br&gt;• Evidence ủng hộ hoặc bác bỏ:&lt;br&gt;• Giới hạn / quyền truy cập:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CC;strokeColor=#D6B656;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="710" height="260" as="geometry"/></mxCell>
        <mxCell id="assumptions-card" value="&lt;b&gt;2. ASSUMPTIONS / OPEN QUESTIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Đơn vị capacity: ghế, bàn hay tổ hợp bàn?&lt;br&gt;• PENDING có giữ chỗ? Bắt đầu/kết thúc lúc nào?&lt;br&gt;• Nguồn capacity nào là chuẩn; có booking từ kênh khác không?&lt;br&gt;• Hành vi khi hai request đến đồng thời?&lt;br&gt;&lt;br&gt;Đánh dấu từng mục: Confirmed / Assumption / Open / Unknown. Ghi owner cần trả lời:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="800" y="210" width="710" height="260" as="geometry"/></mxCell>
        <mxCell id="options-card" value="&lt;b&gt;3. OPTIONS TO EVALUATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;A — Chỉ CONFIRMED tính vào occupancy.&lt;br&gt;Trade-off cần thảo luận: khả năng nhận thêm request / rủi ro tranh chỗ.&lt;br&gt;&lt;br&gt;B — PENDING giữ tạm theo thời hạn được duyệt.&lt;br&gt;Trade-off cần thảo luận: thời gian giữ, giải phóng, vận hành.&lt;br&gt;&lt;br&gt;C — PENDING giữ đến khi staff xử lý.&lt;br&gt;Trade-off cần thảo luận: chậm xử lý có thể giữ capacity lâu.&lt;br&gt;&lt;br&gt;Không chấm điểm nếu tiêu chí/evidence chưa được thống nhất." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="710" height="300" as="geometry"/></mxCell>
        <mxCell id="decisions-card" value="&lt;b&gt;4. DECISIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;DEC-01 — PENDING có giữ capacity không?&lt;br&gt;Status: OPEN — chưa có quyết định được duyệt.&lt;br&gt;&lt;br&gt;Decision authority (vai trò/tên đã xác minh):&lt;br&gt;Quyết định / rationale / evidence:&lt;br&gt;Version / ngày hiệu lực / ngoại lệ:&lt;br&gt;Review trigger:&lt;br&gt;&lt;br&gt;Nếu chưa đủ căn cứ: giữ OPEN, ghi owner và hạn xử lý; không chọn thay authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="800" y="500" width="710" height="300" as="geometry"/></mxCell>
        <mxCell id="parking-card" value="&lt;b&gt;PARKING LOT / QUESTIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Câu hỏi ngoài phạm vi quyết định hôm nay:&lt;br&gt;2. Evidence cần thu thêm:&lt;br&gt;3. Người/nhóm cần tham vấn:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="830" width="710" height="180" as="geometry"/></mxCell>
        <mxCell id="actions-card" value="&lt;b&gt;ACTION LOG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Action | Owner role | Due / review date | Evidence / artifact to update&lt;br&gt;1.&lt;br&gt;2.&lt;br&gt;3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontColor=#333333;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="800" y="830" width="710" height="180" as="geometry"/></mxCell>
        <mxCell id="footer" value="Sau workshop: cập nhật decision log / BRULE-02 / backlog / API / SQL assumption / UAT / RTM theo quyết định có hiệu lực. Template này do trợ lý chuẩn bị, không phải evidence người học đã thực hành." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="1030" width="1460" height="42" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
