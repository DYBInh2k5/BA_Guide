  <diagram id="incident-evidence-map" name="Stakeholder Evidence Map">
    <mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="SỰ CỐ MÔ PHỎNG&lt;br&gt;Hai nhóm cùng nói đã đặt lúc 19:30&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Chưa đối chiếu hồ sơ — chưa phân loại nguyên nhân&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=17;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="390" y="280" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="3" value="QUẢN LÝ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Nguồn lời kể trong role-play&lt;br&gt;Nhớ có sự cố; chưa chắc chi tiết&lt;br&gt;Quyền quyết định: chưa xác minh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4" value="NHÂN VIÊN NHẬN ĐẶT BÀN&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cần hỏi cách nhận và phản hồi&lt;br&gt;Chưa được phỏng vấn trong scenario&lt;br&gt;Decision authority: chưa biết&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="270" height="125" as="geometry" />
