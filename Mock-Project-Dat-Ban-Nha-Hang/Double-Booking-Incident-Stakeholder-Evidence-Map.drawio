        <mxCell id="5" value="HAI NHÓM KHÁCH&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cần xác minh mỗi nhóm đã được báo gì&lt;br&gt;Không dùng dữ liệu nhận dạng thật&lt;br&gt;Trong case học: chỉ là nhân vật giả lập&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#FCE7F3;strokeColor=#DB2777;fontColor=#831843;" vertex="1" parent="1">
          <mxGeometry x="880" y="110" width="270" height="120" as="geometry" />
