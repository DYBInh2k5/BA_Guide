        <mxCell id="6" value="HỒ SƠ CÓ THỂ ĐỐI CHIẾU&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Booking/reference ID; giờ gửi; trạng thái&lt;br&gt;Nội dung xác nhận; lịch bàn nếu có&lt;br&gt;Chưa xác nhận các hồ sơ này tồn tại&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="270" height="125" as="geometry" />
