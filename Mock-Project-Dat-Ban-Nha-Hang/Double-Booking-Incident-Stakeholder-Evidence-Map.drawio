        <mxCell id="15" value="Chú giải&lt;br&gt;Nét đứt = nguồn/việc xác minh dự kiến, không phải luồng quy trình&lt;br&gt;Toàn bộ scenario là giả lập; chưa có stakeholder hoặc hồ sơ thật" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;" vertex="1" parent="1">
