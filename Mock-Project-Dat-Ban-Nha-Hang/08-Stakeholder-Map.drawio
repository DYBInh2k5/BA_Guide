  <diagram id="stakeholder-map" name="Stakeholder Map">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note" value="CASE MÔ PHỎNG — vai trò, mức ảnh hưởng và quyền quyết định cần được xác minh với stakeholder thật." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="change" value="&lt;b&gt;KHÁM PHÁ THAY ĐỔI&lt;/b&gt;&lt;br&gt;Quy trình tiếp nhận và xử lý yêu cầu đặt bàn&lt;br&gt;&lt;br&gt;Problem / need chưa được xác minh&lt;br&gt;App chỉ là một option cần đánh giá" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B82F6;strokeWidth=2;fontSize=18;fontColor=#172554;spacing=12;" vertex="1" parent="1"><mxGeometry x="365" y="240" width="370" height="160" as="geometry" /></mxCell>
        <mxCell id="customer" value="&lt;b&gt;Khách hàng&lt;/b&gt;&lt;br&gt;Người dùng / chịu ảnh hưởng&lt;br&gt;Cần xác minh kỳ vọng về trạng thái đặt bàn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=16;fontColor=#1F2937;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="reception" value="&lt;b&gt;Lễ tân&lt;/b&gt;&lt;br&gt;Người vận hành quy trình&lt;br&gt;Hỏi về handoff, ngoại lệ và thao tác thực tế" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=16;fontColor=#1F2937;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="255" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="manager" value="&lt;b&gt;Quản lý ca&lt;/b&gt;&lt;br&gt;Nguồn thông tin vận hành&lt;br&gt;Có thể đề xuất quy tắc; quyền phê duyệt cần xác nhận" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=16;fontColor=#1F2937;spacing=10;" vertex="1" parent="1"><mxGeometry x="790" y="255" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="owner" value="&lt;b&gt;Chủ nhà hàng / sponsor&lt;/b&gt;&lt;br&gt;Quan tâm mục tiêu, chi phí, policy&lt;br&gt;Decision authority: chưa xác minh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=16;fontColor=#7C2D12;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="485" width="290" height="110" as="geometry" /></mxCell>
        <mxCell id="delivery" value="&lt;b&gt;Dev / QA&lt;/b&gt;&lt;br&gt;Tư vấn feasibility và testability&lt;br&gt;Không tự phê duyệt business policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=16;fontColor=#1F2937;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="290" height="110" as="geometry" /></mxCell>
        <mxCell id="e-customer" value="Trải nghiệm / kỳ vọng" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#64748B;fontSize=13;fontColor=#334155;" edge="1" parent="1" source="customer" target="change"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-reception" value="Thực hiện / ngoại lệ" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#64748B;fontSize=13;fontColor=#334155;" edge="1" parent="1" source="reception" target="change"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-manager" value="Vận hành / rule input" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#64748B;fontSize=13;fontColor=#334155;" edge="1" parent="1" source="manager" target="change"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-owner" value="Mục tiêu / phê duyệt? xác minh" style="dashed=1;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#EA580C;fontSize=13;fontColor=#9A3412;" edge="1" parent="1" source="owner" target="change"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-delivery" value="Feasibility / quality input" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#64748B;fontSize=13;fontColor=#334155;" edge="1" parent="1" source="delivery" target="change"><mxGeometry relative="1" as="geometry" /></mxCell>
