<mxfile host="app.diagrams.net" modified="2026-11-21T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="reservation-system-context" name="System Context">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SYSTEM CONTEXT — BOOKING REQUEST (DRAFT)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1450" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Case study giả lập · ranh giới và luồng đề xuất để review, chưa phải tích hợp/solution đã duyệt" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="50" y="75" width="1450" height="32" as="geometry"/></mxCell>

        <mxCell id="system-boundary" value="PROPOSED BOOKING REQUEST MANAGEMENT SYSTEM&#xa;(Phạm vi hệ thống đề xuất — Draft)&#xa;&#xa;• Nhận và validate booking request&#xa;• Áp dụng business rule về giờ/capacity sau khi được duyệt&#xa;• Lưu reference và trạng thái PENDING&#xa;• Cung cấp queue để staff quyết định; ghi audit history&#xa;• Phát yêu cầu email sau state change theo policy&#xa;&#xa;Chưa mô tả hạ tầng hoặc database implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FF;strokeColor=#4676B8;strokeWidth=2;dashed=1;fontSize=18;fontColor=#172B4D;align=left;verticalAlign=middle;spacing=22;" vertex="1" parent="1"><mxGeometry x="410" y="250" width="650" height="470" as="geometry"/></mxCell>

        <mxCell id="customer" value="CUSTOMER&#xa;(External actor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=16;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="95" y="385" width="150" height="150" as="geometry"/></mxCell>
        <mxCell id="staff" value="RESTAURANT STAFF&#xa;(Reception / manager)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=16;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="85" y="650" width="170" height="150" as="geometry"/></mxCell>
        <mxCell id="email-provider" value="EMAIL PROVIDER&#xa;(External service — proposed)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#5B9BD5;fontSize=16;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1250" y="390" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="capacity-note" value="OPEN QUESTION — CAPACITY SOURCE&#xa;Ai sở hữu capacity và trạng thái nào giữ chỗ?&#xa;Cấu hình nội bộ hay nguồn ngoài? Chưa xác nhận integration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontColor=#5B4B00;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1190" y="640" width="300" height="125" as="geometry"/></mxCell>

        <mxCell id="cust-request" value="Booking request: ngày/giờ, party size, contact tối thiểu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.32;entryX=0;entryY=0.32;strokeColor=#3D6F9E;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customer" target="system-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cust-result" value="Reference + PENDING, hoặc validation / slot-unavailable outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.68;entryX=0;entryY=0.68;strokeColor=#3D6F9E;strokeWidth=2;startArrow=block;startFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="customer" target="system-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="staff-view" value="Queue, request detail, state history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.32;entryX=0;entryY=0.78;strokeColor=#557A46;strokeWidth=2;startArrow=block;startFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="staff" target="system-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="staff-decision" value="Confirm / reject + reason (authorized staff; policy TBD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.68;entryX=0;entryY=0.88;strokeColor=#557A46;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="staff" target="system-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="notify-send" value="Email event after approved state change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.35;entryX=0;entryY=0.4;strokeColor=#6A4C93;strokeWidth=2;endArrow=block;endFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system-boundary" target="email-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="notify-result" value="Delivery result / callback (if provider supports — TBD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.68;entryX=0;entryY=0.72;strokeColor=#6A4C93;strokeWidth=2;dashed=1;startArrow=block;startFill=1;fontSize=14;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system-boundary" target="email-provider"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="capacity-open" value="Source and policy unresolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.92;entryX=0;entryY=0.25;strokeColor=#D6B656;strokeWidth=2;dashed=1;endArrow=none;fontSize=13;fontColor=#5B4B00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system-boundary" target="capacity-note"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="SCOPE NOTE&#xa;System boundary = responsibility, not infrastructure. No POS, payment, SMS, real vendor, data store, or production integration is assumed. Confirm actors, owner, source, policy and error behavior during discovery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#A6A6A6;fontSize=14;fontColor=#424B54;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="410" y="780" width="1080" height="125" as="geometry"/></mxCell>
